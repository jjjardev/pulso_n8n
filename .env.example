# ---------------------------------------------------------------------------
# Copy to `.env` and edit. `.env` is gitignored; this file is not.
#
#   cp .env.example .env
#
# docker compose reads `.env` automatically when it is next to the compose
# file, so no `export` is needed.
# ---------------------------------------------------------------------------

# --- REQUIRED -------------------------------------------------------------
# Encrypts n8n credentials at rest. Changing it after a credential exists
# makes that credential unreadable, so set it once and back up the volume.
#
# Generate a real one:
#     openssl rand -hex 32
#
# The value this repo originally shipped with was
# `change-me-to-a-long-random-string`. It was safe only while n8n held zero
# credentials, which is why it is worth replacing before storing anything real.
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string

# --- OPTIONAL -------------------------------------------------------------
# Where finished PDF reports are written. This must be a directory the
# container user (uid 1000) can write to. See OPERATIONS.md section 5 for the
# permission fix if reports fail to appear.
DOWNLOAD_DIR=${HOME}/Downloads/review-pulso

# --- TAGASENTI ------------------------------------------------------------
# Optional overrides, mainly for running the model service outside the repo.
# Uncomment only if the defaults in agent_journal/*.py do not resolve for you.
#TAGASENTI_DIR=/absolute/path/to/tagasenti
#MODEL_PATH=/absolute/path/to/tagasenti_int8.onnx